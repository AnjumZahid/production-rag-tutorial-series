APP_NAME=Production RAG API
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

api_key = 'shfdsfjkshf'

# ====================================

EMBEDDING_PROVIDER=huggingface

# ======================================

OPENAI_API_KEY=your-real-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_MAX_INPUT_TOKENS=8000
OPENAI_EMBEDDING_MAX_BATCH_TOKENS=250000

OPENAI_EMBEDDING_MAX_RETRIES=6
OPENAI_EMBEDDING_INITIAL_RETRY_DELAY=1
OPENAI_EMBEDDING_MAX_RETRY_DELAY=60
OPENAI_EMBEDDING_BATCH_DELAY=0.25
OPENAI_TIMEOUT_SECONDS=60

# =========================================

# Active vector database provider.
# Later this can be changed to qdrant.
VECTOR_STORE_PROVIDER=chroma

# Local Chroma storage.
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Database created inside each organization tenant.
CHROMA_DATABASE_NAME=rag_app

# Default number of retrieved chunks.
RETRIEVAL_TOP_K=4

# ================================================

DATABASE_URL=mysql+asyncmy://rag_user:RagUserPassword_2026_7x@127.0.0.1:3306/rag_app

# =================================================

LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_LLM_TIMEOUT_SECONDS=60
GEMINI_LLM_MAX_RETRIES=3
GEMINI_LLM_INITIAL_RETRY_DELAY_SECONDS=1
GEMINI_LLM_MAX_RETRY_DELAY_SECONDS=30
GEMINI_LLM_MAX_OUTPUT_TOKENS=1200
GEMINI_LLM_TEMPERATURE=0.2
GEMINI_LLM_THINKING_BUDGET=0

# =================================================

AUTH_JWT_SECRET_KEY=change-this-to-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=rag-app
AUTH_JWT_AUDIENCE=rag-app-api
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_JWT_LEEWAY_SECONDS=10
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================
# API SECURITY
# ============================================================

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false

TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

SECURITY_FORCE_HTTPS=false
SECURITY_ENABLE_HSTS=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000


# ============================================================
# STEP - REDIS / RATE LIMITING
# ============================================================

REDIS_URL=redis://127.0.0.1:6379/0

REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

RATE_LIMIT_ENABLED=true

# false = Redis failure rejects protected requests
RATE_LIMIT_FAIL_OPEN=false

RATE_LIMIT_KEY_PREFIX=rag-api

# ------------------------------------------------------------
# General API
# 300 requests / 60 seconds / IP
# ------------------------------------------------------------

RATE_LIMIT_GENERAL_REQUESTS=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# ------------------------------------------------------------
# Registration
# 5 requests / hour / IP
# ------------------------------------------------------------

RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# ------------------------------------------------------------
# Login
# 10 requests / 15 minutes / IP
# ------------------------------------------------------------

RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# ------------------------------------------------------------
# Refresh
# 30 requests / 10 minutes / IP
# ------------------------------------------------------------

RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=600

# ------------------------------------------------------------
# Document upload
# 20 requests / hour / authenticated user
# ------------------------------------------------------------

RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600

# ------------------------------------------------------------
# RAG query
# 60 requests / minute / authenticated user
# ------------------------------------------------------------

RATE_LIMIT_RAG_REQUESTS=60
RATE_LIMIT_RAG_WINDOW_SECONDS=60