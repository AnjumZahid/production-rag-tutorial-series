APP_NAME=Production RAG API
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

api_key = 'shfdsfjkshf'

# ====================================

EMBEDDING_PROVIDER=huggingface

# ======================================

OPENAI_API_KEY=sk-your-real-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_MAX_INPUT_TOKENS=8000
OPENAI_EMBEDDING_MAX_BATCH_TOKENS=250000

OPENAI_EMBEDDING_MAX_RETRIES=6
OPENAI_EMBEDDING_INITIAL_RETRY_DELAY=1
OPENAI_EMBEDDING_MAX_RETRY_DELAY=60
OPENAI_EMBEDDING_BATCH_DELAY=0.25
OPENAI_TIMEOUT_SECONDS=60

# =========================================

# Active vector database provider.
# Later this can be changed to qdrant.
VECTOR_STORE_PROVIDER=chroma

# Local Chroma storage.
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Database created inside each organization tenant.
CHROMA_DATABASE_NAME=rag_app

# Default number of retrieved chunks.
RETRIEVAL_TOP_K=4

# ================================================

DATABASE_URL=mysql+asyncmy://rag_user:RagUserPassword_2026_7x@127.0.0.1:3306/rag_app

# =================================================

LLM_PROVIDER=gemini

GEMINI_API_KEY= your-gcp-api-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_LLM_TIMEOUT_SECONDS=60
GEMINI_LLM_MAX_RETRIES=3
GEMINI_LLM_INITIAL_RETRY_DELAY_SECONDS=1
GEMINI_LLM_MAX_RETRY_DELAY_SECONDS=30
GEMINI_LLM_MAX_OUTPUT_TOKENS=1200
GEMINI_LLM_TEMPERATURE=0.2
GEMINI_LLM_THINKING_BUDGET=0

